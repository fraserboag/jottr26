# Supabase project settings -> API. Both values are safe to expose in the
# browser: the anon key only grants what row level security allows, and every
# policy in supabase/schema.sql is "your own rows, nothing else".
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
